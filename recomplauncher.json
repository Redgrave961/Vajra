{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Vajra (Asura's Wrath)",
  "repo": "Redgrave961/Vajra",
  "inputs": [
    {
      "id": "game",
      "label": "Your PlayStation 3 copy of Asura's Wrath (BLES01227 EU or BLUS30721 US): disc folder (PS3_GAME) or decrypted .iso.",
      "formats": [
        { "type": "file", "extensions": ["iso"] },
        { "type": "folder" }
      ],
      "check": {
        "ids": ["BLES01227", "BLUS30721"]
      }
    },
    {
      "id": "update",
      "label": "Official 1.02 update (.pkg). Optional: leave blank to download automatically from Sony during setup.",
      "role": "update",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc1",
      "label": "DLC: Episode 11.5 (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc2",
      "label": "DLC: Episode 15.5 (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc3",
      "label": "DLC: Part IV Nirvana (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc4",
      "label": "DLC: Lost Episode 1 (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc5",
      "label": "DLC: Lost Episode 2 (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    },
    {
      "id": "dlc6",
      "label": "DLC: Devastator / Infinity Pack (.pkg, EU or US). Optional. Keep its matching .rap key beside the .pkg or in exdata/.",
      "role": "dlc",
      "optional": true,
      "formats": [
        { "type": "file", "extensions": ["pkg"] }
      ]
    }
  ],
  "prepare": {
    "program": ["Vajra.exe", "Vajra-x86_64.AppImage"],
    "args": ["--prepare", "--data", "{data}", "--game={input:game}", "--update={input:update}", "--dlc1={input:dlc1}", "--dlc2={input:dlc2}", "--dlc3={input:dlc3}", "--dlc4={input:dlc4}", "--dlc5={input:dlc5}", "--dlc6={input:dlc6}"],
    "label": "Official 1.02 update and PS3 audio codecs",
    "done": [
      "{data}/user/dev_flash/sys/external/flashMP3.pic",
      "{data}/user/dev_flash/sys/external/flashATRAC.pic",
      "{data}/asura_paths.ini"
    ]
  },
  "start": {
    "program": ["Vajra.exe", "Vajra-x86_64.AppImage"],
    "args": ["--data", "{data}", "--game={input:game}", "--update={input:update}", "--dlc1={input:dlc1}", "--dlc2={input:dlc2}", "--dlc3={input:dlc3}", "--dlc4={input:dlc4}", "--dlc5={input:dlc5}", "--dlc6={input:dlc6}"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{data}/asura_settings.ini" }]
    }
  ],
  "settings": [
    {
      "id": "display",
      "label": "Display Mode",
      "help": "Windowed, borderless window, or exclusive fullscreen at the display's native mode.",
      "group": "Graphics",
      "choices": [
        { "label": "Windowed", "set": { "display": "windowed" } },
        { "label": "Borderless", "set": { "display": "borderless" } },
        { "label": "Fullscreen", "set": { "display": "fullscreen" } }
      ],
      "defaults": { "display": "borderless" }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "Internal rendering resolution. 720p is the PlayStation 3 original.",
      "group": "Graphics",
      "choices": [
        { "label": "720p (1280x720)", "set": { "resolution": "1280x720" } },
        { "label": "900p (1600x900)", "set": { "resolution": "1600x900" } },
        { "label": "1080p (1920x1080)", "set": { "resolution": "1920x1080" } },
        { "label": "1440p (2560x1440)", "set": { "resolution": "2560x1440" } },
        { "label": "1800p (3200x1800)", "set": { "resolution": "3200x1800" } },
        { "label": "4K (3840x2160)", "set": { "resolution": "3840x2160" } }
      ],
      "defaults": { "resolution": "1920x1080" }
    },
    {
      "id": "frame_rate",
      "label": "Frame Rate",
      "help": "Frame rate limit. 30 FPS uses the console's original pacing.",
      "group": "Graphics",
      "choices": [
        { "label": "30 FPS (Console)", "set": { "frame_rate": "30" } },
        { "label": "60 FPS", "set": { "frame_rate": "60" } },
        { "label": "120 FPS", "set": { "frame_rate": "120" } },
        { "label": "144 FPS", "set": { "frame_rate": "144" } },
        { "label": "165 FPS", "set": { "frame_rate": "165" } },
        { "label": "180 FPS", "set": { "frame_rate": "180" } },
        { "label": "240 FPS", "set": { "frame_rate": "240" } },
        { "label": "Unlimited", "set": { "frame_rate": "unlimited" } }
      ],
      "defaults": { "frame_rate": "unlimited" }
    },
    {
      "id": "anti_aliasing",
      "label": "SMAA",
      "help": "Subpixel morphological anti-aliasing for smoother edges.",
      "group": "Graphics",
      "choices": [
        { "label": "On", "set": { "anti_aliasing": "on" } },
        { "label": "Off", "set": { "anti_aliasing": "off" } }
      ],
      "defaults": { "anti_aliasing": "on" }
    },
    {
      "id": "motion_blur",
      "label": "Motion Blur",
      "help": "Blur from camera and object motion.",
      "group": "Graphics",
      "choices": [
        { "label": "On", "set": { "motion_blur": "on" } },
        { "label": "Off", "set": { "motion_blur": "off" } }
      ],
      "defaults": { "motion_blur": "on" }
    },
    {
      "id": "depth_of_field",
      "label": "Depth of Field",
      "help": "Blur outside the camera's focus, mainly in cutscenes.",
      "group": "Graphics",
      "choices": [
        { "label": "On", "set": { "depth_of_field": "on" } },
        { "label": "Off", "set": { "depth_of_field": "off" } }
      ],
      "defaults": { "depth_of_field": "on" }
    },
    {
      "id": "bloom",
      "label": "Bloom",
      "help": "Glow around bright lights.",
      "group": "Graphics",
      "choices": [
        { "label": "On", "set": { "bloom": "on" } },
        { "label": "Off", "set": { "bloom": "off" } }
      ],
      "defaults": { "bloom": "on" }
    },
    {
      "id": "language",
      "label": "Language",
      "help": "Text and menu language. Takes effect on next launch.",
      "group": "Language",
      "choices": [
        { "label": "System Default", "set": { "language": "auto" } },
        { "label": "English", "set": { "language": "en" } },
        { "label": "Japanese", "set": { "language": "ja" } },
        { "label": "French", "set": { "language": "fr" } },
        { "label": "Spanish", "set": { "language": "es" } },
        { "label": "German", "set": { "language": "de" } },
        { "label": "Italian", "set": { "language": "it" } }
      ],
      "defaults": { "language": "auto" }
    },
    {
      "id": "mouse_sensitivity",
      "label": "Mouse Sensitivity",
      "help": "How fast the camera turns with the mouse.",
      "group": "Controls",
      "slider": {
        "key": "mouse_sensitivity",
        "min": 1,
        "max": 20,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": { "mouse_sensitivity": "10" }
    },
    {
      "id": "invert_mouse_y",
      "label": "Invert Mouse Y",
      "help": "Moving the mouse forward looks down.",
      "group": "Controls",
      "choices": [
        { "label": "Off", "set": { "invert_mouse_y": "off" } },
        { "label": "On", "set": { "invert_mouse_y": "on" } }
      ],
      "defaults": { "invert_mouse_y": "off" }
    },
    {
      "id": "god_mode",
      "label": "God Mode",
      "help": "Invincibility and full health.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "god_mode": "off" } },
        { "label": "On", "set": { "god_mode": "on" } }
      ],
      "defaults": { "god_mode": "off" }
    },
    {
      "id": "inf_burst",
      "label": "Infinite Burst",
      "help": "Keep the Burst gauge full at all times.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "inf_burst": "off" } },
        { "label": "On", "set": { "inf_burst": "on" } }
      ],
      "defaults": { "inf_burst": "off" }
    },
    {
      "id": "inf_unlimited",
      "label": "Infinite Unlimited",
      "help": "Keep the Unlimited gauge full and prevent forced deactivation.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "inf_unlimited": "off" } },
        { "label": "On", "set": { "inf_unlimited": "on" } }
      ],
      "defaults": { "inf_unlimited": "off" }
    },
    {
      "id": "one_hit_kill",
      "label": "One-Hit Kills",
      "help": "Defeat enemies in a single hit.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "one_hit_kill": "off" } },
        { "label": "On", "set": { "one_hit_kill": "on" } }
      ],
      "defaults": { "one_hit_kill": "off" }
    },
    {
      "id": "damage_mult",
      "label": "Damage Multiplier",
      "help": "Multiply damage dealt to enemies.",
      "group": "Cheats",
      "choices": [
        { "label": "1x", "set": { "damage_mult": "1x" } },
        { "label": "2x", "set": { "damage_mult": "2x" } },
        { "label": "4x", "set": { "damage_mult": "4x" } },
        { "label": "8x", "set": { "damage_mult": "8x" } },
        { "label": "16x", "set": { "damage_mult": "16x" } }
      ],
      "defaults": { "damage_mult": "1x" }
    },
    {
      "id": "auto_qte",
      "label": "Automatic Perfect QTEs",
      "help": "Instantly complete button, stick, and mash QTEs, and hit timed Synchronic Impacts with Excellent timing.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "auto_qte": "off" } },
        { "label": "On", "set": { "auto_qte": "on" } }
      ],
      "defaults": { "auto_qte": "off" }
    },
    {
      "id": "hold_mash",
      "label": "Hold Instead of Mash",
      "help": "Hold the prompted button instead of rapidly mashing.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "hold_mash": "off" } },
        { "label": "On", "set": { "hold_mash": "on" } }
      ],
      "defaults": { "hold_mash": "off" }
    },
    {
      "id": "ext_qte_timer",
      "label": "Extended QTE Timers",
      "help": "Slow QTE countdowns and widen Synchronic timing windows.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "ext_qte_timer": "off" } },
        { "label": "1.5x", "set": { "ext_qte_timer": "1.5x" } },
        { "label": "2x", "set": { "ext_qte_timer": "2x" } },
        { "label": "3x", "set": { "ext_qte_timer": "3x" } }
      ],
      "defaults": { "ext_qte_timer": "off" }
    },
    {
      "id": "unlock_episodes",
      "label": "Unlock All Episodes",
      "help": "Access all episodes without modifying your save file.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "unlock_episodes": "off" } },
        { "label": "On", "set": { "unlock_episodes": "on" } }
      ],
      "defaults": { "unlock_episodes": "off" }
    },
    {
      "id": "unlock_gauges",
      "label": "Unlock All Gauges",
      "help": "Access all gauges without modifying your save file.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "unlock_gauges": "off" } },
        { "label": "On", "set": { "unlock_gauges": "on" } }
      ],
      "defaults": { "unlock_gauges": "off" }
    },
    {
      "id": "unlock_extras",
      "label": "Unlock All Extras",
      "help": "Access all Art, CG, Movies, and Interludes without modifying your save.",
      "group": "Cheats",
      "choices": [
        { "label": "Off", "set": { "unlock_extras": "off" } },
        { "label": "On", "set": { "unlock_extras": "on" } }
      ],
      "defaults": { "unlock_extras": "off" }
    }
  ],
  "groups": [
    { "id": "Cheats", "advanced": true }
  ],
  "saves": [
    "{data}/user/dev_hdd0/home/00000001/savedata",
    "{data}/user/dev_hdd0/home/00000001/trophy",
    "{data}/asura_settings.ini"
  ],
  "folders": {
    "data": [{ "path": "{data}" }],
    "logs": [{ "path": "{data}" }],
    "saves": [{ "path": "{data}/user/dev_hdd0/home/00000001/savedata" }],
    "exdata": [{ "path": "{data}/user/dev_hdd0/home/00000001/exdata" }]
  },
  "actions": [
    {
      "id": "open-saves",
      "label": "Open Save Folder",
      "open": "saves"
    },
    {
      "id": "open-exdata",
      "label": "Open DLC Keys (exdata) Folder",
      "help": "Place .rap license files here (or next to your DLC .pkg files) to unlock paid DLC.",
      "open": "exdata"
    },
    {
      "id": "clear-cache",
      "label": "Clear Shader Cache",
      "help": "Deletes compiled Vulkan shader and pipeline caches so they rebuild on next launch.",
      "clear": "data/cache"
    }
  ],
  "looks": {
    "graphics": "vulkan"
  },
  "exit_codes": {
    "2": "Setup was cancelled or required game files are missing.",
    "3": "No BLES01227 or BLUS30721 game copy was provided.",
    "4": "Failed to download the official 1.02 update from Sony. Check your internet connection or select the .pkg manually.",
    "5": "Failed to download or extract the PS3 firmware audio codecs from Sony. Check your internet connection.",
    "6": "The selected game copy or update failed verification. Make sure you have a decrypted BLES01227 (EU) or BLUS30721 (US) dump."
  },
  "system": {
    "windows": {
      "version": "10",
      "graphics": { "vulkan": "1.3" }
    },
    "linux": {
      "graphics": { "vulkan": "1.3" }
    }
  }
}
