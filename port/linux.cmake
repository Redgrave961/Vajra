foreach(var ASURA_LLVM_BIN ASURA_SYSROOT)
    if(NOT ${var})
        set(${var} "$ENV{${var}}")
    endif()
endforeach()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ASURA_LLVM_BIN ASURA_SYSROOT)

set(CMAKE_C_COMPILER "${ASURA_LLVM_BIN}/clang${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_CXX_COMPILER "${ASURA_LLVM_BIN}/clang++${CMAKE_HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_C_FLAGS_INIT "-fno-pie")
set(CMAKE_CXX_FLAGS_INIT "-fno-pie")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-no-pie -fuse-ld=lld -stdlib=libc++ -static-libstdc++ -rtlib=compiler-rt -unwindlib=libunwind -static-libgcc")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-l:libc++abi.a")

if(ASURA_SYSROOT)
    set(CMAKE_SYSTEM_NAME Linux)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(CMAKE_SYSROOT "${ASURA_SYSROOT}")
    set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu)
    set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu)
    string(APPEND CMAKE_CXX_FLAGS_INIT " -nostdinc++ -isystem ${ASURA_SYSROOT}/usr/include/c++/v1")
    file(GLOB ASURA_RESOURCE_DIR "${ASURA_SYSROOT}/usr/lib/clang/*")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -resource-dir=${ASURA_RESOURCE_DIR}")
else()
    string(APPEND CMAKE_CXX_FLAGS_INIT " -stdlib=libc++")
endif()
