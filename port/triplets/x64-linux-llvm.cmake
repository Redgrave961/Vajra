set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_ENV_PASSTHROUGH ASURA_LLVM_BIN ASURA_SYSROOT ASURA_SYSROOT_VERSION ASURA_WAYLAND_SCANNER PKG_CONFIG PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_LIBDIR PKG_CONFIG_DONT_DEFINE_PREFIX)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../linux.cmake")
if(PORT STREQUAL "sdl3")
    set(VCPKG_CMAKE_CONFIGURE_OPTIONS
        -DSDL_DEPS_SHARED=ON
        -DSDL_X11=ON -DSDL_X11_XCURSOR=ON -DSDL_X11_XDBE=ON -DSDL_X11_XFIXES=ON -DSDL_X11_XINPUT=ON -DSDL_X11_XRANDR=ON
        -DSDL_X11_XSCRNSAVER=ON -DSDL_X11_XSHAPE=ON -DSDL_X11_XSYNC=ON -DSDL_X11_XTEST=ON
        -DSDL_WAYLAND=ON -DSDL_WAYLAND_LIBDECOR=ON -DSDL_IBUS=OFF -DSDL_DBUS=ON -DSDL_LIBUDEV=ON
        -DSDL_ALSA=ON -DSDL_PULSEAUDIO=ON -DSDL_PIPEWIRE=ON)
    if(DEFINED ENV{ASURA_WAYLAND_SCANNER})
        list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS "-DWAYLAND_SCANNER=$ENV{ASURA_WAYLAND_SCANNER}")
    endif()
endif()
