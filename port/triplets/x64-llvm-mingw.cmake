set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME MinGW)
set(VCPKG_ENV_PASSTHROUGH LLVM_MINGW)
set(VCPKG_CMAKE_CONFIGURE_OPTIONS
    "-DCMAKE_C_COMPILER=$ENV{LLVM_MINGW}/bin/x86_64-w64-mingw32-clang.exe"
    "-DCMAKE_CXX_COMPILER=$ENV{LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++.exe"
    "-DCMAKE_RC_COMPILER=$ENV{LLVM_MINGW}/bin/x86_64-w64-mingw32-windres.exe")
